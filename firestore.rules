rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated user may read/write their own users doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Authenticated user may read/write their worker profile
    match /workers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Authenticated user may read/write their employer profile
    match /employers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vacancies: public reads, only employer may write
    match /vacancies/{vacancyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.employerId;
    }

    // Deny by default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
